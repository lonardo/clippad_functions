{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/workflow-schema.json",
  "title": "Workflow Definition",
  "type": "object",
  "required": ["workflow"],
  "properties": {
    "workflow": {
      "type": "object",
      "required": ["id","name","version","description","created","segments"],
      "properties": {
        "id": {"type":"string"},
        "name":{"type":"string"},
        "version":{"type":"string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description":{"type":"string"},
        "created":{"type":"string","format":"date-time"},
        "segments":{
          "type":"array",
          "items":{"$ref":"#/$defs/segment"},
          "minItems":1
        },
        "variables":{
          "type":"object",
          "additionalProperties": {
            "oneOf": [
              {"type":"string"},
              {"type":"number"},
              {"type":"integer"},
              {"type":"boolean"},
              {"type":"null"}
            ]
          }
        },
        "metadata":{
          "type":"object",
          "properties":{
            "author":{"type":"string"},
            "tags":{"type":"array","items":{"type":"string"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "position": {
      "type":"object",
      "properties":{"x":{"type":"number"},"y":{"type":"number"}},
      "required":["x","y"],
      "additionalProperties": false
    },
    "segment": {
      "type":"object",
      "required":["id","type","name","template","parameters"],
      "properties":{
        "id":{"type":"string"},
        "type":{"type":"string"},
        "name":{"type":"string"},
        "template":{"type":"string"},
        "parameters":{"type":"object"},
        "position":{"$ref":"#/$defs/position"},
        "dependencies":{"type":"array","items":{"type":"string"}},
        "next":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": true
    }
  }
}