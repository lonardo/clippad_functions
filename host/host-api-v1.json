  "generatedFrom": "WorkflowHostMethodList.inl",
  "selectionSemantics": {
    "Host.GetSelection()": {
      "available": true,
      "returns": "plain text from the current Office selection",
      "interactive": false,
      "emptyWhen": [
        "no active host",
        "no active document",
        "no selection text"
      ],
      "recommendedFor": "read-only text extraction from the current selection",
      "preferInstead": {
        "Host.GetSelectionInfo()": "structured selection metadata",
        "Host.GetSelectionObject()": "object-level Office automation",
        "App.Selection": "direct access when the injected Office Application object is already available",
        "Host.SelectRange()": "a new interactive range selection is required"
      },
      "appNotes": {
        "Word": "reads Selection.Text",
        "Excel": "reads the current Selection Value2 when it is a scalar string or number; multi-cell arrays are not guaranteed to be expanded",
        "PowerPoint": "reads text available from the current ShapeRange"
      },
      "caution": "It does not return a Range/Selection COM object and does not open a selection dialog."
    }
  },
