{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/format-profile-schema.json",
  "title": "Office Versioned Format Profile",
  "type": "object",
  "required": ["profileVersion", "id", "domain", "displayName", "status", "source", "applicableDocumentTypes", "formatRules", "guardrails"],
  "properties": {
    "profileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "domain": { "type": "string", "enum": ["legal", "official", "contract", "report", "paper", "custom"] },
    "displayName": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "user_confirmed", "archived"] },
    "source": { "$ref": "#/$defs/source" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "applicableDocumentTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "formatRules": {
      "type": "object",
      "required": ["title", "heading", "body", "table", "page", "headerFooter"],
      "properties": {
        "title": { "$ref": "#/$defs/rule" },
        "heading": { "$ref": "#/$defs/rule" },
        "body": { "$ref": "#/$defs/rule" },
        "table": { "$ref": "#/$defs/rule" },
        "page": { "$ref": "#/$defs/rule" },
        "headerFooter": { "$ref": "#/$defs/rule" }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "object",
      "required": ["preserveBusinessContent", "requiresPreview", "requiresConfirmation", "prohibitedOperations"],
      "properties": {
        "preserveBusinessContent": { "type": "boolean" },
        "requiresPreview": { "type": "boolean" },
        "requiresConfirmation": { "type": "boolean" },
        "prohibitedOperations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "label", "version", "confirmedByUser"],
      "properties": {
        "kind": { "type": "string", "enum": ["user_template", "local_profile", "organization_template"] },
        "label": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "authority": { "type": "string" },
        "confirmedByUser": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["mode", "fields", "required"],
      "properties": {
        "mode": { "type": "string", "enum": ["sample_derived", "explicit", "disabled"] },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required": { "type": "boolean" },
        "notes": { "type": "string" },
        "values": { "type": "object" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["samplePath", "sampleDocumentName"],
      "properties": {
        "samplePath": { "type": "string", "minLength": 1 },
        "sampleDocumentName": { "type": "string", "minLength": 1 },
        "sampleFileInfo": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
